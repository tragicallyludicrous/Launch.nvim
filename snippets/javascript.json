{
  "p5 sketch skeleton": {
    "prefix": "p5sketch",
    "body": [
      "function setup() {",
      "  createCanvas(${1:400}, ${2:400});",
      "}",
      "",
      "function draw() {",
      "  background(${3:220});",
      "  $0",
      "}"
    ],
    "description": "Basic p5.js sketch (setup + draw)"
  },
  "p5 sketch skeleton (WEBGL)": {
    "prefix": "p5sketchwebgl",
    "body": [
      "function setup() {",
      "  createCanvas(${1:400}, ${2:400}, WEBGL);",
      "}",
      "",
      "function draw() {",
      "  background(${3:220});",
      "  $0",
      "}"
    ],
    "description": "p5.js sketch in 3D/WEBGL mode"
  },
  "p5 instance mode": {
    "prefix": "p5instance",
    "body": [
      "const ${1:sketch} = (p) => {",
      "  p.setup = () => {",
      "    p.createCanvas(${2:400}, ${3:400});",
      "  };",
      "",
      "  p.draw = () => {",
      "    p.background(${4:220});",
      "    $0",
      "  };",
      "};",
      "",
      "new p5(${1:sketch});"
    ],
    "description": "p5.js instance-mode sketch (no globals)"
  },
  "p5 setup": {
    "prefix": "setup",
    "body": ["function setup() {", "  createCanvas(${1:400}, ${2:400});", "  $0", "}"],
    "description": "p5.js setup() function"
  },
  "p5 draw": {
    "prefix": "draw",
    "body": ["function draw() {", "  $0", "}"],
    "description": "p5.js draw() loop"
  },
  "p5 async load (2.0)": {
    "prefix": "p5load",
    "body": [
      "let ${1:img};",
      "",
      "async function setup() {",
      "  createCanvas(${2:400}, ${3:400});",
      "  ${1:img} = await loadImage('${4:assets/image.png}');",
      "  $0",
      "}"
    ],
    "description": "p5.js 2.0 async asset loading (replaces preload)"
  },
  "p5 windowResized": {
    "prefix": "windowResized",
    "body": ["function windowResized() {", "  resizeCanvas(${1:windowWidth}, ${2:windowHeight});", "  $0", "}"],
    "description": "p5.js windowResized() handler"
  },
