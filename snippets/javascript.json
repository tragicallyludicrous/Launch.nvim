  "p5 class (particle)": {
    "prefix": "p5class",
    "body": [
      "class ${1:Particle} {",
      "  constructor(x, y) {",
      "    this.pos = createVector(x, y);",
      "    this.vel = createVector(0, 0);",
      "    this.acc = createVector(0, 0);",
      "  }",
      "",
      "  update() {",
      "    this.vel.add(this.acc);",
      "    this.pos.add(this.vel);",
      "    this.acc.mult(0);",
      "  }",
      "",
      "  show() {",
      "    $0",
      "    circle(this.pos.x, this.pos.y, ${2:8});",
      "  }",
      "}"
    ],
    "description": "p5.js particle/agent class template"
  }
